{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ECTM ServiceHost",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AeroTech.ECTM.ServiceHost/bin/Debug/net10.0/AeroTech.ECTM.ServiceHost.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/AeroTech.ECTM.ServiceHost",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:4748"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
