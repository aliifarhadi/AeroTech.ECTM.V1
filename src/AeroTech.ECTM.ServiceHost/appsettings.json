{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "IdGenerator": {
    "GeneratorId": 0
  },
  "ResourceLock": {
    "ExpirySeconds": 30
  },
  "ProcessingJobs": {
    "LeaseMinutes": 15,
    "PollIntervalSeconds": 5
  },
  "AllowedHosts": "*"
}
